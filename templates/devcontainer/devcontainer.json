{
  // Dev container config for a project derived from develop-template.
  //
  // Copy this single file to <your-project>/.devcontainer/devcontainer.json.
  // Nothing else needs to be copied: the post-create script and the shared lint
  // configs are baked into the image.
  //
  // Replace OWNER/REPO with the repository that publishes the image.
  "name": "CHANGE ME",

  // Node version is chosen by the tag: node20 / node22 / node24 (latest = node22).
  // Pin to a dated tag (e.g. node22-20260912) for a fully reproducible container.
  "image": "ghcr.io/OWNER/REPO/devcontainer:node22",

  "containerEnv": {
    // Python and Terraform are switched at container-create time by
    // post-create.sh, so they do not require a different image.
    // Delete either line to keep the version baked into the image.
    "PYTHON_VERSION": "3.13",
    "TERRAFORM_VERSION": "1.16.2",

    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/developer/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "hashicorp.terraform",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "timonwong.shellcheck",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit",
          "source.organizeImports.ruff": "explicit"
        },
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
        "python.defaultInterpreterPath": "/opt/uv/bin/python",
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },

  "remoteUser": "developer",

  "mounts": [
    "source=devcontainer-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=devcontainer-gcloud-${devcontainerId},target=/home/developer/.config/gcloud,type=volume",
    "source=devcontainer-azure-${devcontainerId},target=/home/developer/.azure,type=volume",
    "source=${localEnv:HOME}/.claude,target=/home/developer/.claude,type=bind"
  ],

  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",

  "postCreateCommand": "devcontainer-post-create",
  "waitFor": "postCreateCommand"
}
