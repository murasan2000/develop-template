# docker compose / ローカル実行で共有する環境変数のひな形。
# `cp .env.example .env` してから値を埋める。`.env` はコミットしない。

# --- Gemini / Google ADK -----------------------------------------------------
# Google AI Studio (https://aistudio.google.com/apikey) で発行した API キー。
GOOGLE_API_KEY=
# Gemini Developer API を使う。Vertex AI に切り替えるなら TRUE にしたうえで
# GOOGLE_CLOUD_PROJECT / GOOGLE_CLOUD_LOCATION を足す。
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# 使用するモデル。gemini-3.8-flash が現行の標準（速度・コスト・性能のバランス）。
GEMINI_MODEL=gemini-3.8-flash
# モデル呼び出しの試行回数（初回を含む）。Gemini は混雑時に 503 UNAVAILABLE を
# 返すことがあり、これは時間を置けば成功する一時的な失敗なので自動で再試行する。
# 1 にするとリトライ無効。
AGENT_RETRY_MAX_ATTEMPTS=3

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=app_local_password
POSTGRES_DB=chat
# api コンテナから見た接続先。ホストから直接 api を起動する場合は db を localhost に。
DATABASE_URL=postgresql+asyncpg://app:app_local_password@db:5432/chat

# --- アプリ ------------------------------------------------------------------
# CORS 許可オリジン（カンマ区切り）。
CORS_ORIGINS=http://localhost:5173
# 認証を持たないテンプレートなので、ADK セッションの所有者は固定値にしている。
# 認証を足すときは、ここをログインユーザー ID に差し替える。
DEFAULT_USER_ID=local-user
LOG_LEVEL=INFO

# --- ファイル置き場 ----------------------------------------------------------
# ファイル実体の保存先ディレクトリ。空ならリポジトリ直下の storage/ を使う。
# compose では /data/storage にマウントするので docker-compose.yml 側が上書きする。
STORAGE_DIR=
# 1 ファイルあたりのサイズ上限（バイト）。既定 10 MiB。
UPLOAD_MAX_FILE_BYTES=10485760
# 1 メッセージに添付できる件数と、その合計サイズの上限（バイト、既定 15 MiB）。
# 添付は Gemini へ inline で渡すため、この上限は「1 リクエストで API プロセスが
# メモリに載せる量」の上限も兼ねている。
UPLOAD_MAX_FILES_PER_MESSAGE=5
UPLOAD_MAX_TOTAL_BYTES_PER_MESSAGE=15728640
# アップロードを許可する MIME タイプ（カンマ区切り）。ここに無いものは 415 で弾く。
# 許可されていても Gemini が読めない形式（zip / json など）は、モデルには
# ファイル名とサイズだけが伝わる（エラーにはしない）。
UPLOAD_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/webp,image/gif,application/pdf,text/plain,text/markdown,text/csv,application/json,application/zip
# どのメッセージにも紐づかないままのファイルを掃除するまでの時間（時間単位）。
ORPHAN_FILE_TTL_HOURS=24
